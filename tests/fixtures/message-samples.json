  "content": "{\"multi_reference\":{},\"search_references\":[{\"text_card\":{\"id\":10560257078641154,\"summary\":\"\",\"title\":\"南通市-天气查询_墨迹\",\"sitename\":\"\",\"url\":\"https://html5.moji.com/tpd/mojiweather_h5/index.html#/home?cityid=1108\\u0026platform=doubao\",\"logo_url\":\"\",\"doc_id\":\"c2d5b29ed2ce91ba-ae34919cafaae1ed\",\"image_url\":\"\",\"has_image\":false,\"publish_time_second\":\"\",\"original_doc_rank\":0,\"source_from\":0,\"source_id\":\"\",\"…[len=5033]",
  "content_status": 0,
